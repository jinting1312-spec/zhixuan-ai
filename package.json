{
  "name": "zhixuan-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/runtime-env.mjs ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "node --import ./scripts/runtime-env.mjs ./node_modules/next/dist/bin/next build",
    "start": "node --import ./scripts/runtime-env.mjs ./node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:api": "node --env-file=.env.local scripts/test-fuyao.mjs",
    "test:llm": "node --env-file=.env.local scripts/test-llm.mjs",
    "test:live": "node --env-file=.env.local --conditions=react-server --import tsx scripts/verify-live.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
